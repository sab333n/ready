# Copy to .env.local. Everything except DATABASE_URL has a working local default.

# Local Postgres or a Supabase connection string (Project settings -> Database).
DATABASE_URL=postgres://localhost:5432/ready_dev
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000

# Google sign-in (Supabase Auth, same setup as Interlink). Email and password
# still work against this app's database when these are blank.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LLM: "gemini" reads syllabi, screenshots, and the classroom. "none" uses the offline parser.
# "anthropic" is the Claude alternative (needs ANTHROPIC_API_KEY).
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=gemini-3.5-flash
# Tried in order when LLM_MODEL is out of quota or overloaded.
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite

# Realtime voice classroom (Gemini Live). Leave blank for text-only classrooms.
GEMINI_API_KEY=
VOICE_MODEL=gemini-2.5-flash-native-audio-latest
# Whiteboard diagrams in voice classrooms. Comma-separated, tried in order.
IMAGE_MODEL=gemini-3.1-flash-image,gemini-2.5-flash-image

# Twilio (Phase 4). Used now only to verify inbound STOP webhooks.
TWILIO_AUTH_TOKEN=
