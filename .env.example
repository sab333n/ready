# Copy to .env.local. Everything except DATABASE_URL has a working local default.

# Local Postgres or a Supabase connection string (Project settings -> Database).
DATABASE_URL=postgres://localhost:5432/ready_dev
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000

# Supabase email magic-link sign-in. Leave blank to use dev sign-in (email only, no link).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LLM: "anthropic" to read syllabi/screenshots with Claude, "none" for the offline heuristic parser.
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Twilio (Phase 4). Used now only to verify inbound STOP webhooks.
TWILIO_AUTH_TOKEN=
